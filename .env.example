# =============================================================================
# Lang RAG Assistant - Environment Variables
# =============================================================================
# Copy this file to .env and fill in at least one API key.
# Never commit .env to version control (it is already in .gitignore).

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Provider preselected in the app. Options: google_genai, groq, openai
# Default: google_genai
LLM_PROVIDER=google_genai

# Model name for each provider (optional; defaults are used if omitted)
GOOGLE_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# LLM Provider API Keys
# -----------------------------------------------------------------------------
# A model can be chosen in the app only when its key is set here.
# Google Gemini API key. Get yours at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# Groq API key. Get yours at: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI API key. Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Embedding Configuration
# -----------------------------------------------------------------------------
# Embedding model (native/local via sentence-transformers).
# Options: BGE-M3, nomic-embed-text, all-MiniLM-L6-v2
# Default: all-MiniLM-L6-v2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Max concurrent analyst subagents (min 2, max 5)
# Default: 3
MAX_CONCURRENT_ANALYSTS=3

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Set the logging level for the application.
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO
